{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-thomastp",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "thomastp.ch", "custom_domain": true },
    { "pattern": "www.thomastp.ch", "custom_domain": true },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
}
