{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": "off",
    "react/set-state-in-effect": "off",
    "react/refs": "off",
    "react/purity": "off",
    "react/use-memo": "off"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["dist", "node_modules", "cloudflare-worker", "public"],
  "overrides": [
    {
      "files": ["scripts/**/*.{js,mjs,cjs}", "*.{js,mjs,cjs}"],
      "env": {
        "node": true
      }
    }
  ]
}
